# ---- Go ----
# cgo/c-shared 编译产物
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# ---- Rust ----
# 构建目录（Cargo.lock 不忽略：宿主是二进制项目，应入库）
target/
**/*.rs.bk

# ---- WebUI ----
# 前端依赖与构建产物，入库只留源码
webui/node_modules/
webui/dist/
# 插件构建页的产物（源码在 extensions/<名>/ui-src/，同 dist 道理）；
# demo_ui 是免构建手写页，ui.js 本身就是源码，不在此列
extensions/*_ui/ui.js
extensions/*_ui/.uibuild/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.ruff_cache/

# ---- Agent ----
# .agent/ 存放项目 agent 工作规范文档，入库；
# 其余是各工具的个人配置与本地状态，不入库
/.workbuddy/
/.zcode/
/.claude/
/.cursor/
/.codex/
/.gemini/
/.copilot/
/.aider*

# ---- 本地内容 ----
# 本机演示，暂不入库
/demo/
# 运行时产物（状态快照等）
/data/
# 本机构建产物与含真实 token 的配置（模板除外）
/bin/
/config/*
!/config/loquat.yaml.example
# 私人编译器配置（本机路径），缺失时构建回退 PATH 里的 go
/compile.toml
# 设计稿与原型（本地保留）
/design/
# 插件配置是运行时状态（个人 token、启停声明），不入库：
# 有 SCHEMA 的插件缺失它会被提示 install，按 SCHEMA 生成
extensions/*/config.yaml
# 启停标记同理是运行时状态（enable/disable 写入/删除）
extensions/*/.disabled

# 编辑器 / 系统
.DS_Store
Thumbs.db
