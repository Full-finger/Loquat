# 首次运行自动生成本文件。缺省只启用沙箱：直接启动即可在 WebUI「沙箱」选项卡对话。
# plugins.adapters 拉起哪些适配器（可多选，下行按 platform 路由）：
#   每项 = { name, path, env }；path 省略用默认 bin/adapter-<name>.exe；
#   enabled: false 表示停用（保留定义与参数）；
#   env 的键名由各适配器自己约定，核心不解释内容。
plugins:
  adapters:
    - name: sandbox
    # 连真实 QQ（经 NapCat）时解开注释并填入你的参数：
    # - name: napcat
    #   env:
    #     LOQUAT_NAPCAT_URL: ws://127.0.0.1:3001
    #     LOQUAT_NAPCAT_TOKEN: 请填入你的access_token
